# Absolute URL of the deployed app. Becomes the metadataBase that resolves
# the Open Graph / Twitter image URLs and the canonical link. Set it to your
# production domain (e.g. https://enterprise-ai-galaxy.vercel.app) and mirror
# it as the NEXT_PUBLIC_SITE_URL repository secret for CI.
NEXT_PUBLIC_SITE_URL=https://enterprise-ai-galaxy.vercel.app
